@page
@model ClothesStoreOODAProject.Pages.Products.IndexModel

<h2>Danh sach Product</h2>
<a asp-page="/Products/Create">+ Them moi</a>

<table border="1" cellpadding="5">
    <tr>
        <th>Id</th><th>Ten</th><th>Danh muc</th><th>Hanh dong</th>
    </tr>
@foreach (var item in Model.Products)
{
    <tr>
        <td>@item.Id</td>
        <td>@item.Name</td>
        <td>@(item.Category?.Name ?? "-")</td>
        <td>
            <a asp-page="/Products/Details" asp-route-id="@item.Id">Chi tiet</a> |
            <a asp-page="/Products/Edit" asp-route-id="@item.Id">Sua</a> |
            <a asp-page="/Products/Delete" asp-route-id="@item.Id">Xoa</a>
        </td>
    </tr>
}
</table>
