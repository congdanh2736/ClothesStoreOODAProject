@page "{id:int}"
@model ClothesStoreOODAProject.Pages.Categories.EditModel

<h2>Sua Category</h2>
<form method="post">
    <input type="hidden" asp-for="Category.Id" />
    <div>
        <label>Ten</label>
        <input asp-for="Category.Name" />
    </div>
    <div>
        <label>Danh muc cha</label>
        <select asp-for="Category.ParentId" asp-items="Model.ParentList">
            <option value="">-- Khong co --</option>
        </select>
    </div>
    <button type="submit">Luu</button>
</form>
<a asp-page="Index">Quay lai</a>
