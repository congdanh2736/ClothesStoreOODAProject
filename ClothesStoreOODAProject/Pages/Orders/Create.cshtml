@page
@model ClothesStoreOODAProject.Pages.Orders.CreateModel

<h2>Them Order</h2>
<form method="post">
    <div>
        <label>Khach hang</label>
        <select asp-for="Order.CustomerId" asp-items="Model.CustomerList">
            <option value="">-- Chon khach hang --</option>
        </select>
    </div>
    <div>
        <label>Dia chi giao hang</label>
        <select asp-for="Order.AddressId" asp-items="Model.AddressList">
            <option value="">-- Chon dia chi --</option>
        </select>
    </div>
    <div>
        <label>Khuyen mai (khong bat buoc)</label>
        <select asp-for="Order.PromotionId" asp-items="Model.PromotionList">
            <option value="">-- Khong ap dung --</option>
        </select>
    </div>
    <div>
        <label>Tong tien</label>
        <input asp-for="Order.TotalAmount" type="number" step="0.01" />
    </div>
    <button type="submit">Luu</button>
</form>
<a asp-page="Index">Quay lai</a>
